<?xml version="1.0" encoding="utf-8"?>
<!--
  Datbox 品牌 logo (登录/关于/首页左上角): 与桌面 launcher 图标同一幅图。
  图形与坐标完全沿用 ic_launcher_background (渐变底) + ic_launcher_foreground (白匣: 盖/体/数据条),
  保证 App 内 logo 与 app 图标观感一致; 外圈用圆角 r24 收边 (launcher 由系统 mask 收边),
  便于在 App 内不经裁剪直接当图标展示。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角渐变底 (同 ic_launcher_background) -->
    <path android:pathData="M24,0 h60 a24,24 0 0 1 24,24 v60 a24,24 0 0 1 -24,24 h-60 a24,24 0 0 1 -24,-24 v-60 a24,24 0 0 1 24,-24 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#25CFA5"
                android:endColor="#0E9C77" />
        </aapt:attr>
    </path>

    <!-- 盒盖 (同 ic_launcher_foreground) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,28 h36 a5,5 0 0 1 5,5 v3 a5,5 0 0 1 -5,5 h-36 a5,5 0 0 1 -5,-5 v-3 a5,5 0 0 1 5,-5 z" />

    <!-- 盒体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,54 a8,8 0 0 1 8,-8 h24 a8,8 0 0 1 8,8 v16 a8,8 0 0 1 -8,8 h-24 a8,8 0 0 1 -8,-8 z" />

    <!-- 数据条 -->
    <path
        android:fillColor="#20C997"
        android:pathData="M42,55 h20 a2.5,2.5 0 0 1 0,5 h-20 a2.5,2.5 0 0 1 0,-5 z" />
    <path
        android:fillColor="#20C997"
        android:pathData="M42,65 h14 a2.5,2.5 0 0 1 0,5 h-14 a2.5,2.5 0 0 1 0,-5 z" />
</vector>
